import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { Icon, Btn, IconBtn, TextField, Check, Dropdown, Segmented, FieldLabel, Sep, Spinner, ProgressBar } from "widgets.slint";

component Modal inherits Rectangle {
    in property <length> dlg-width: 460px;
    in property <string> title;
    in property <bool> prod: false;
    callback dismissed();
    background: Theme.scrim;
    TouchArea { clicked => { } }
    Rectangle {
        width: min(root.dlg-width, parent.width - 40px);
        height: min(card.preferred-height, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: 12px;
        border-width: root.prod ? 2px : 1px;
        border-color: root.prod ? Theme.danger : Theme.border;
        clip: true;
        TouchArea { }
        card := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { }
                IconBtn { glyph: "\u{E711}"; box: 26px; clicked => { root.dismissed(); } }
            }
            @children
        }
    }
}

export component ConfirmDialog inherits Modal {
    title: Backend.dlg-title;
    prod: Backend.dlg-prod;
    dlg-width: 520px;
    dismissed => { Backend.dlg-result(0); }
    Text {
        text: Backend.dlg-text;
        font-size: 13px;
        color: Theme.text;
        wrap: word-wrap;
    }
    if Backend.dlg-detail != "": Rectangle {
        height: min(180px, d.preferred-height + 20px);
        background: Theme.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        d := Text {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            text: Backend.dlg-detail;
            font-size: 11px;
            font-family: Theme.mono;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        if !Backend.dlg-info: Btn { text: Backend.t("cancel"); clicked => { Backend.dlg-result(0); } }
        if Backend.dlg-alt != "": Btn { text: Backend.dlg-alt; clicked => { Backend.dlg-result(2); } }
        Btn {
            text: Backend.dlg-ok;
            kind: Backend.dlg-danger ? "danger" : "primary";
            clicked => { Backend.dlg-result(1); }
        }
    }
}

export component ConnectionDialog inherits Modal {
    title: Backend.conn-dlg-edit ? Backend.t("conn.edit") : Backend.t("conn.new");
    dlg-width: 560px;
    dismissed => { Backend.cd-cancel(); }
    VerticalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: Backend.t("conn.name"); }
            TextField { value: Backend.cd-name; edited(t) => { Backend.cd-name = t; } }
        }
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: Backend.t("conn.engine"); }
            Dropdown {
                model: Backend.cd-engines;
                current-index: Backend.cd-engine;
                selected(i) => { Backend.cd-engine-picked(i); }
            }
        }
        if Backend.cd-driver != 0: Rectangle {
            background: (Backend.cd-driver == 1 || Backend.cd-driver == 4) ? Theme.accent-soft : Theme.danger-soft;
            border-radius: 6px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: Backend.cd-driver-text;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if Backend.cd-driver == 1: HorizontalLayout {
                    Btn {
                        text: Backend.cd-driver-busy ? Backend.t("driver.installing") : Backend.t("driver.install");
                        kind: "primary";
                        enabled: !Backend.cd-driver-busy;
                        clicked => { Backend.cd-driver-install(); }
                    }
                    Rectangle { }
                }
            }
        }
        if Backend.cd-file-based: VerticalLayout {
            spacing: 4px;
            FieldLabel { text: Backend.t("conn.file"); }
            HorizontalLayout {
                spacing: 6px;
                TextField { value: Backend.cd-path; edited(t) => { Backend.cd-path = t; } }
                Btn { text: Backend.t("conn.browse"); clicked => { Backend.cd-browse(); } }
            }
        }
        if !Backend.cd-file-based: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 3;
                    FieldLabel { text: Backend.t("conn.host"); }
                    TextField { value: Backend.cd-host; edited(t) => { Backend.cd-host = t; } }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    FieldLabel { text: Backend.t("conn.port"); }
                    TextField { value: Backend.cd-port; edited(t) => { Backend.cd-port = t; } }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: Backend.t("conn.user"); }
                    TextField { value: Backend.cd-user; edited(t) => { Backend.cd-user = t; } }
                }
                VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: Backend.t("conn.password"); }
                    TextField { value: Backend.cd-password; password: true; placeholder: Backend.t("conn.password-hint"); edited(t) => { Backend.cd-password = t; } }
                }
            }
            VerticalLayout {
                spacing: 4px;
                FieldLabel { text: Backend.t("conn.database"); }
                TextField { value: Backend.cd-database; edited(t) => { Backend.cd-database = t; } }
            }
            Check { text: Backend.t("conn.tls"); checked: Backend.cd-tls; toggled(c) => { Backend.cd-tls = c; if (c) { Backend.cd-trust = false; } } }
            Check {
                text: Backend.t("conn.trust");
                checked: Backend.cd-trust;
                enabled: Backend.cd-tls;
                toggled(c) => { Backend.cd-trust = c; }
            }
            if Backend.cd-trust: Text {
                text: Backend.t("conn.trust-warning");
                font-size: 11px;
                color: Theme.warning;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: Backend.t("conn.environment"); }
            Segmented {
                model: [Backend.t("env.dev"), Backend.t("env.test"), Backend.t("env.staging"), Backend.t("env.prod")];
                current-index: Backend.cd-env;
                selected(i) => { Backend.cd-env = i; }
            }
        }
        Check { text: Backend.t("conn.readonly"); checked: Backend.cd-read-only; toggled(c) => { Backend.cd-read-only = c; } }
        if Backend.cd-message != "": Text {
            text: Backend.cd-message;
            font-size: 12px;
            color: Backend.cd-message-error ? Theme.danger : Theme.success;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Btn { text: Backend.cd-testing ? Backend.t("conn.testing") : Backend.t("conn.test"); enabled: !Backend.cd-testing; clicked => { Backend.cd-test(); } }
            Rectangle { }
            Btn { text: Backend.t("cancel"); clicked => { Backend.cd-cancel(); } }
            Btn { text: Backend.t("save"); clicked => { Backend.cd-save(false); } }
            Btn { text: Backend.t("conn.save-connect"); kind: "primary"; clicked => { Backend.cd-save(true); } }
        }
    }
}

export component ExportDialog inherits Modal {
    title: Backend.t("export.title");
    dlg-width: 480px;
    dismissed => { if (!Backend.exp-running) { Backend.exp-open = false; } }
    Text {
        text: Backend.exp-summary;
        font-size: 13px;
        color: Theme.text;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("export.format"); }
        Segmented {
            model: ["CSV", "TSV", "JSON", "NDJSON", "SQL"];
            current-index: Backend.exp-format;
            selected(i) => { Backend.exp-format = i; }
        }
    }
    if Backend.exp-format < 2: Check {
        text: Backend.t("export.header");
        checked: Backend.exp-header;
        toggled(c) => { Backend.exp-header = c; }
    }
    if Backend.exp-running: HorizontalLayout {
        spacing: 10px;
        Spinner { }
        Text {
            text: Backend.exp-progress;
            font-size: 12px;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Btn {
            text: Backend.exp-running ? Backend.t("cancel") : Backend.t("close");
            clicked => { if (Backend.exp-running) { Backend.exp-cancel(); } else { Backend.exp-open = false; } }
        }
        Btn {
            text: Backend.t("export.start");
            kind: "primary";
            enabled: !Backend.exp-running;
            clicked => { Backend.exp-start(); }
        }
    }
}

export component DetailDialog inherits Modal {
    title: Backend.detail-title;
    dlg-width: 640px;
    dismissed => { Backend.detail-open = false; }
    Rectangle {
        height: 320px;
        background: Theme.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        ScrollView {
            Text {
                x: 10px;
                width: parent.visible-width - 20px;
                text: Backend.detail-body;
                font-size: 12px;
                font-family: Theme.mono;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Btn { text: Backend.t("close"); clicked => { Backend.detail-open = false; } }
    }
}

export component HistoryDialog inherits Modal {
    title: Backend.t("hist.title");
    dlg-width: 700px;
    dismissed => { Backend.hist-open = false; }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            horizontal-stretch: 1;
            placeholder: Backend.t("hist.search");
            edited(t) => { Backend.hist-search(t); }
        }
        Btn {
            text: Backend.t("hist.favorites");
            icon: "\u{E734}";
            kind: Backend.hist-favorites-only ? "primary" : "default";
            clicked => {
                Backend.hist-favorites-only = !Backend.hist-favorites-only;
                Backend.hist-favorites-toggled(Backend.hist-favorites-only);
            }
        }
    }
    Rectangle {
        height: 340px;
        background: Theme.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        if Backend.hist-rows.length == 0: Text {
            text: Backend.hist-total == 0 ? Backend.t("hist.empty") : Backend.t("hist.no-match");
            font-size: 13px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        ListView {
            for h[i] in Backend.hist-rows: Rectangle {
                height: 52px;
                background: row-ta.has-hover ? Theme.hover : transparent;
                row-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Backend.hist-use(i); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 4px;
                    IconBtn {
                        glyph: h.favorite ? "\u{E735}" : "\u{E734}";
                        active: h.favorite;
                        y: (parent.height - self.height) / 2;
                        clicked => { Backend.hist-toggle-favorite(i); }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: h.preview;
                            font-size: 12px;
                            font-family: Theme.mono;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: h.when + (h.runs > 1 ? "  Â·  Ã—" + h.runs : "");
                            font-size: 11px;
                            color: Theme.text-faint;
                        }
                    }
                    IconBtn {
                        glyph: "\u{E74D}";
                        y: (parent.height - self.height) / 2;
                        clicked => { Backend.hist-delete(i); }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
        }
    }
    Text {
        text: Backend.t("hist.note");
        font-size: 11px;
        color: Theme.text-faint;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        Btn { text: Backend.t("hist.clear"); kind: "ghost"; enabled: Backend.hist-total > 0; clicked => { Backend.hist-clear(); } }
        Rectangle { }
        Btn { text: Backend.t("close"); clicked => { Backend.hist-open = false; } }
    }
}

export component ColumnsDialog inherits Modal {
    title: Backend.t("cols.title");
    dlg-width: 460px;
    dismissed => { Backend.colcfg-open = false; }
    Text {
        text: Backend.t("cols.note");
        font-size: 12px;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    Rectangle {
        height: 320px;
        background: Theme.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        ListView {
            for c[i] in Backend.colcfg-rows: Rectangle {
                height: 38px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 6px;
                    Check {
                        checked: c.shown;
                        y: (parent.height - self.height) / 2;
                        toggled => { Backend.colcfg-toggle(i); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: c.name;
                        font-size: 12px;
                        color: c.shown ? Theme.text : Theme.text-faint;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconBtn { glyph: "\u{E70E}"; enabled: !c.first; y: (parent.height - self.height) / 2; clicked => { Backend.colcfg-move(i, -1); } }
                    IconBtn { glyph: "\u{E70D}"; enabled: !c.last; y: (parent.height - self.height) / 2; clicked => { Backend.colcfg-move(i, 1); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Btn { text: Backend.t("cols.reset"); kind: "ghost"; clicked => { Backend.colcfg-reset(); } }
        Rectangle { }
        Btn { text: Backend.t("close"); clicked => { Backend.colcfg-open = false; } }
    }
}

export component CopyAsDialog inherits Modal {
    title: Backend.t("copyas.title");
    dlg-width: 440px;
    dismissed => { Backend.copyas-open = false; }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("export.format"); }
        Segmented {
            model: ["TSV", "CSV", "JSON", "INSERT"];
            current-index: Backend.copyas-format;
            selected(i) => { Backend.copyas-format = i; }
        }
    }
    Text { text: Backend.t("copyas.note"); font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Btn { text: Backend.t("copyas.row"); enabled: Backend.sel-row >= 0; clicked => { Backend.copyas-do(0); } }
        Btn { text: Backend.t("copyas.page"); clicked => { Backend.copyas-do(1); } }
        Rectangle { }
        Btn { text: Backend.t("close"); kind: "ghost"; clicked => { Backend.copyas-open = false; } }
    }
}

export component PasteDialog inherits Modal {
    title: Backend.t("paste.title");
    dlg-width: 520px;
    dismissed => { Backend.paste-open = false; }
    Text { text: Backend.paste-summary; font-size: 12px; color: Theme.text; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Btn { text: Backend.t("cancel"); kind: "ghost"; clicked => { Backend.paste-open = false; } }
        Btn { text: Backend.t("paste.confirm"); enabled: Backend.paste-can-confirm; clicked => { Backend.paste-confirm(); } }
    }
}

export component SavedFiltersDialog inherits Modal {
    title: Backend.t("sf.title");
    dlg-width: 520px;
    dismissed => { Backend.sf-open = false; }
    property <string> new-name;
    Text { text: Backend.t("sf.note"); font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            horizontal-stretch: 1;
            placeholder: Backend.t("sf.name");
            edited(t) => { root.new-name = t; }
            accepted(t) => { Backend.sf-save(t); }
        }
        Btn {
            text: Backend.t("sf.save");
            enabled: Backend.sf-active-count > 0 && root.new-name != "";
            clicked => { Backend.sf-save(root.new-name); }
        }
    }
    Rectangle {
        height: 240px;
        background: Theme.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        if Backend.sf-rows.length == 0: Text {
            text: Backend.t("sf.empty");
            font-size: 13px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        ListView {
            for s[i] in Backend.sf-rows: Rectangle {
                height: 48px;
                background: sf-ta.has-hover ? Theme.hover : transparent;
                sf-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Backend.sf-use(i); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 4px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text { text: s.name; font-size: 13px; color: Theme.text; overflow: elide; }
                        Text { text: s.summary; font-size: 11px; color: Theme.text-faint; overflow: elide; }
                    }
                    IconBtn { glyph: "\u{E74D}"; tint: Theme.danger; y: (parent.height - self.height) / 2; clicked => { Backend.sf-delete(i); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
        }
    }
    HorizontalLayout {
        Rectangle { }
        Btn { text: Backend.t("close"); clicked => { Backend.sf-open = false; } }
    }
}

export component SettingsDialog inherits Modal {
    title: Backend.t("settings.title");
    dlg-width: 540px;
    dismissed => { Backend.settings-open = false; }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("settings.appearance"); }
        Segmented {
            model: [Backend.t("settings.dark"), Backend.t("settings.light")];
            current-index: Backend.theme-index;
            selected(i) => { Backend.settings-theme(i); }
        }
    }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("settings.language"); }
        Segmented {
            model: ["EspaÃ±ol", "English"];
            current-index: Backend.lang-index;
            selected(i) => { Backend.settings-lang(i); }
        }
    }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("settings.page-size"); }
        Segmented {
            model: ["50", "100", "250", "500", "1000"];
            current-index: Backend.settings-page-size-index;
            selected(i) => { Backend.settings-page-size(i); }
        }
    }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("settings.monitor-interval"); }
        Segmented {
            model: ["1 s", "2 s", "5 s", "10 s", "30 s"];
            current-index: Backend.monitor-interval-index;
            selected(i) => { Backend.settings-monitor-interval(i); }
        }
    }
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: Backend.t("settings.query-timeout"); }
        Segmented {
            model: [Backend.t("settings.timeout-off"), "30 s", "1 min", "5 min", "10 min"];
            current-index: Backend.query-timeout-index;
            selected(i) => { Backend.settings-query-timeout(i); }
        }
    }
    Sep { }
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: Backend.t("settings.updates");
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
            Rectangle { }
            Text {
                text: Backend.t("settings.version") + " " + Backend.app-version;
                font-size: 12px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }
        Check {
            text: Backend.t("settings.auto-update");
            checked: Backend.auto-update;
            toggled(c) => { Backend.settings-auto-update(c); }
        }
        Text {
            text: Backend.t("settings.update-privacy");
            font-size: 11px;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
        if Backend.upd-text != "": HorizontalLayout {
            spacing: 8px;
            if Backend.upd-state == 1 || Backend.upd-state == 5: Spinner { size: 14px; }
            Text {
                text: Backend.upd-text;
                font-size: 12px;
                color: Backend.upd-state == 6 ? Theme.danger : Backend.upd-state == 3 ? Theme.accent : Theme.text;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        if Backend.upd-state == 3 && Backend.upd-notes != "": Rectangle {
            height: 110px;
            background: Theme.surface2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            ScrollView {
                Text {
                    x: 10px;
                    y: 8px;
                    width: parent.visible-width - 20px;
                    text: Backend.upd-notes;
                    font-size: 11px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }
        }
        if Backend.upd-state == 4: ProgressBar { value: Backend.upd-progress; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn {
                text: Backend.t("settings.check");
                icon: "\u{E72C}";
                enabled: Backend.upd-state != 1 && Backend.upd-state != 4 && Backend.upd-state != 5;
                clicked => { Backend.check-updates(); }
            }
            if Backend.upd-state == 3: Btn {
                text: Backend.t("settings.install");
                icon: "\u{E896}";
                kind: "primary";
                clicked => { Backend.start-update(); }
            }
        }
    }
    Sep { }
    VerticalLayout {
        spacing: 8px;
        FieldLabel { text: Backend.t("settings.folders"); }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn { text: Backend.t("settings.data-dir"); icon: "\u{E8B7}"; clicked => { Backend.open-data-dir(); } }
            Btn { text: Backend.t("settings.drivers-dir"); icon: "\u{E8B7}"; clicked => { Backend.open-drivers-dir(); } }
            Btn { text: Backend.t("settings.crash-logs"); icon: "\u{E9D9}"; clicked => { Backend.open-logs-dir(); } }
        }
        Text {
            text: Backend.t("settings.crash-logs-note");
            font-size: 11px;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        Btn { text: Backend.t("close"); clicked => { Backend.settings-open = false; } }
    }
}

export component AboutDialog inherits Modal {
    title: Backend.t("about.title");
    dlg-width: 480px;
    dismissed => { Backend.about-open = false; }
    VerticalLayout {
        spacing: 8px;
        Text {
            text: "Db Pro " + Backend.about-version;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: Backend.t("about.description");
            font-size: 13px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        Sep { }
        Text {
            text: Backend.about-copyright;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: Backend.t("about.privacy");
            font-size: 12px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        Btn {
            text: Backend.about-repository;
            icon: "\u{E71B}";
            clicked => { Backend.open-repository(); }
        }
    }
    HorizontalLayout {
        alignment: end;
        Btn { text: Backend.t("close"); clicked => { Backend.about-open = false; } }
    }
}
